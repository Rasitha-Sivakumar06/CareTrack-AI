# ==============================================================================
# CareTrack AI — Version Control Exclusions (.gitignore)
# ==============================================================================

# Environment files & Secrets (Strictly Excluded)
.env
.env.*
*.env
backend/.env
frontend/.env
*.local

# Python Environments & Caching
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.cover
.hypothesis/

# Node & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo

# Uploads & Media Files (Confidential / Temporary Test Attachments)
backend/uploads/
uploads/
*.pdf
*.png
*.jpg
*.jpeg

# Application Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.swp
*.swo

# IDE & Operating System Artifacts
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

/App.jsx.inspect.txt
